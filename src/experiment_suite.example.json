{
  "output_root": "results/experiments",
  "defaults": {
    "dataset": "MD17",
    "model": "tensornet",
    "batch_size": 32,
    "epochs": 10,
    "lr": 0.0001,
    "delta_learning": true,
    "baseline_eps": 0.01,
    "baseline_sigma": 1.0,
    "baseline_cutoff": 5.0,
    "device": "cuda",
    "system_type": "single",
    "run_standard": true,
    "run_physics": true,
    "run_compare": true,
    "run_rollout": true,
    "physics_overrides": {
      "momentum_weight": 0.005,
      "nve_weight": 0.002,
      "nve_freq": 200,
      "traj_length": 30,
      "nve_warmup_epochs": 6,
      "nve_ramp_epochs": 4,
      "nve_relative": true,
      "pbc_weight": 0.0
    },
    "physics_model_grid": [
      {
        "embedding_dimension": 256,
        "num_layers": 6,
        "num_rbf": 64
      },
      {
        "embedding_dimension": 128,
        "num_layers": 4,
        "num_rbf": 64
      },
      {
        "embedding_dimension": 64,
        "num_layers": 2,
        "num_rbf": 64
      }
    ],
    "rollout": {
      "steps": 5000,
      "dt": 0.1,
      "n_rollouts": 10,
      "seed": 42,
      "energy_log_stride": 20,
      "data_root": "./data"
    }
  },
  "experiments": [
    {
      "name": "aspirin_small_physics",
      "molecule": "aspirin"
    },
    {
      "name": "ethanol_small_physics",
      "molecule": "ethanol"
    },
    {
      "name": "benzene_small_physics",
      "molecule": "benzene"
    },
    {
      "name": "uracil_small_physics",
      "molecule": "uracil"
    }
  ]
}
