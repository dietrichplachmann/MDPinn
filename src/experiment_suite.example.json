{
  "output_root": "results/experiments",
  "_documentation": {
    "overwrite_existing": "Set to true on an experiment to delete and recreate that experiment's output folder before running.",
    "physics_defaults": [
      "momentum regularization is disabled by default for MD17 single-molecule sweeps because the model already encodes most symmetry structure.",
      "nve_loss_mode=total_energy regularizes K+U drift instead of potential-only drift.",
      "nve_dt_fs is aligned to rollout dt so the training-side trajectory regularizer matches evaluation.",
      "the NVE warmup/ramp/frequency defaults are tuned so the physics loss actually contributes during short 10-epoch development sweeps."
    ]
  },
  "defaults": {
    "dataset": "MD17",
    "model": "tensornet",
    "batch_size": 32,
    "epochs": 10,
    "lr": 0.0001,
    "delta_learning": true,
    "baseline_eps": 0.01,
    "baseline_sigma": 1.0,
    "baseline_cutoff": 5.0,
    "device": "cuda",
    "system_type": "single",
    "run_standard": true,
    "run_physics": true,
    "run_compare": true,
    "run_rollout": true,
    "physics_overrides": {
      "momentum_weight": 0.0,
      "nve_weight": 0.01,
      "nve_freq": 50,
      "traj_length": 30,
      "nve_warmup_epochs": 1,
      "nve_ramp_epochs": 3,
      "nve_loss_mode": "total_energy",
      "nve_dt_fs": 0.1,
      "nve_relative": true,
      "pbc_weight": 0.0
    },
    "physics_model_grid": [
      {
        "embedding_dimension": 256,
        "num_layers": 6,
        "num_rbf": 64
      },
      {
        "embedding_dimension": 128,
        "num_layers": 4,
        "num_rbf": 64
      },
      {
        "embedding_dimension": 64,
        "num_layers": 2,
        "num_rbf": 64
      }
    ],
    "rollout": {
      "steps": 5000,
      "dt": 0.1,
      "n_rollouts": 10,
      "seed": 42,
      "energy_log_stride": 20,
      "data_root": "./data"
    }
  },
  "experiments": [
    {
      "name": "aspirin_small_physics",
      "molecule": "aspirin",
      "overwrite_existing": true
    },
    {
      "name": "ethanol_small_physics",
      "molecule": "ethanol",
      "overwrite_existing": true
    },
    {
      "name": "benzene_small_physics",
      "molecule": "benzene",
      "overwrite_existing": true
    },
    {
      "name": "uracil_small_physics",
      "molecule": "uracil",
      "overwrite_existing": true
    }
  ]
}
