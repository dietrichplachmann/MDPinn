{
  "output_root": "results/experiments",
  "_documentation": {
    "overwrite_existing": "Set to true on an experiment to delete and recreate that experiment's output folder before running.",
    "runner": "Omit runner or set runner=grid for the existing fixed-grid workflow. Set runner=optuna to let experiment_suite launch an Optuna study for that experiment.",
    "optuna_stages": "Optional two-stage Optuna flow. Stage entries run in order; stage 1 can promote best params into stage 2 fixed_params.",
    "physics_defaults": [
      "momentum regularization is disabled by default for MD17 single-molecule sweeps because the model already encodes most symmetry structure.",
      "nve_loss_mode=total_energy regularizes K+U drift instead of potential-only drift.",
      "nve_dt_fs is aligned to rollout dt so the training-side trajectory regularizer matches evaluation.",
      "the NVE warmup/ramp/frequency defaults are tuned so the physics loss actually contributes during short 10-epoch development sweeps."
    ]
  },
  "defaults": {
    "dataset": "MD17",
    "model": "tensornet",
    "batch_size": 32,
    "epochs": 10,
    "lr": 0.0001,
    "delta_learning": true,
    "baseline_eps": 0.01,
    "baseline_sigma": 1.0,
    "baseline_cutoff": 5.0,
    "device": "cuda",
    "system_type": "single",
    "run_standard": true,
    "run_physics": true,
    "run_compare": true,
    "run_rollout": true,
    "physics_overrides": {
      "momentum_weight": 0.0,
      "nve_weight": 0.01,
      "nve_freq": 50,
      "traj_length": 30,
      "nve_warmup_epochs": 1,
      "nve_ramp_epochs": 3,
      "nve_loss_mode": "total_energy",
      "nve_dt_fs": 0.1,
      "nve_relative": true,
      "pbc_weight": 0.0
    },
    "physics_model_grid": [
      {
        "embedding_dimension": 256,
        "num_layers": 6,
        "num_rbf": 64
      },
      {
        "embedding_dimension": 128,
        "num_layers": 4,
        "num_rbf": 64
      },
      {
        "embedding_dimension": 64,
        "num_layers": 2,
        "num_rbf": 64
      }
    ],
    "rollout": {
      "steps": 5000,
      "dt": 0.1,
      "n_rollouts": 10,
      "seed": 42,
      "energy_log_stride": 20,
      "data_root": "./data"
    }
  },
  "experiments": [
    {
      "name": "aspirin_optuna_physics",
      "runner": "optuna",
      "molecule": "aspirin",
      "overwrite_existing": false,
      "epochs": 10,
      "run_compare": true,
      "run_rollout": true,
      "optuna_post": {
        "run_compare": true,
        "run_rollout": true,
        "reference_epochs": 10
      },
      "optuna": {
        "mode": "physics",
        "n_trials": 10,
        "objective": {
          "metric": "val_total_mse_loss",
          "direction": "minimize"
        },
        "trainer": {
          "max_epochs": 10,
          "num_workers": 0,
          "enable_progress_bar": true,
          "check_val_every_n_epoch": 1,
          "num_sanity_val_steps": 0
        },
        "sampler": {
          "name": "TPESampler",
          "kwargs": {
            "seed": 42
          }
        },
        "pruner": {
          "name": "SuccessiveHalvingPruner",
          "kwargs": {
            "min_resource": 1,
            "reduction_factor": 3,
            "min_early_stopping_rate": 0
          }
        },
        "fixed_params": {
          "train_loss": "mse_loss",
          "train_loss_arg": null,
          "pbc_weight": 0.0
        },
        "search_space": {
          "common": {
            "batch_size": {
              "type": "categorical",
              "choices": [16, 32]
            },
            "lr": {
              "type": "float",
              "low": 1e-05,
              "high": 0.001,
              "log": true
            },
            "weight_decay": {
              "type": "float",
              "low": 1e-08,
              "high": 0.0001,
              "log": true
            },
            "embedding_dimension": {
              "type": "categorical",
              "choices": [64, 128, 256]
            },
            "num_layers": {
              "type": "categorical",
              "choices": [2, 4, 6]
            },
            "num_rbf": {
              "type": "categorical",
              "choices": [32, 64]
            },
            "energy_weight": {
              "type": "float",
              "low": 0.01,
              "high": 0.25
            },
            "force_weight": {
              "type": "float",
              "low": 0.75,
              "high": 0.99
            }
          },
          "physics": {
            "momentum_weight": {
              "type": "float",
              "low": 0.0,
              "high": 0.05
            },
            "nve_weight": {
              "type": "float",
              "low": 0.0,
              "high": 0.05
            }
          },
          "delta": {
            "baseline_epsilon_eV": {
              "type": "float",
              "low": 0.001,
              "high": 0.05,
              "log": true
            },
            "baseline_sigma_A": {
              "type": "float",
              "low": 0.5,
              "high": 2.0
            },
            "baseline_cutoff_A": {
              "type": "float",
              "low": 3.0,
              "high": 8.0
            }
          },
          "nve": {
            "traj_length": {
              "type": "categorical",
              "choices": [20, 30, 40]
            },
            "nve_freq": {
              "type": "categorical",
              "choices": [10, 25, 50]
            },
            "nve_warmup_epochs": {
              "type": "categorical",
              "choices": [0, 1, 2]
            },
            "nve_ramp_epochs": {
              "type": "categorical",
              "choices": [1, 3, 5]
            },
            "nve_relative": {
              "type": "bool"
            },
            "nve_relative_eps": {
              "type": "float",
              "low": 1e-08,
              "high": 0.0001,
              "log": true
            },
            "nve_loss_mode": {
              "type": "categorical",
              "choices": ["total_energy", "potential_only"]
            },
            "nve_dt_fs": {
              "type": "categorical",
              "choices": [0.1, 0.5]
            }
          }
        }
      },
      "optuna_stages": [
        {
          "name": "screen",
          "n_trials": 24,
          "trainer": {
            "max_epochs": 4,
            "check_val_every_n_epoch": 1,
            "limit_train_batches": 0.25,
            "limit_val_batches": 0.5
          },
          "pruner": {
            "name": "NopPruner"
          },
          "promote_best_params_to_next": true
        },
        {
          "name": "full",
          "n_trials": 8,
          "trainer": {
            "max_epochs": 20,
            "check_val_every_n_epoch": 1,
            "limit_train_batches": 1.0,
            "limit_val_batches": 1.0
          },
          "pruner": {
            "name": "MedianPruner",
            "kwargs": {
              "n_startup_trials": 8,
              "n_warmup_steps": 2000,
              "interval_steps": 200
            }
          },
          "search_space": {
            "common": {
              "embedding_dimension": {
                "type": "categorical",
                "choices": [64, 128]
              },
              "num_layers": {
                "type": "categorical",
                "choices": [2, 4]
              }
            },
            "nve": {
              "nve_freq": {
                "type": "categorical",
                "choices": [10, 25]
              }
            }
          }
        }
      ]
    }
  ]
}
