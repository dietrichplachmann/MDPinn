{
  "study_name": "aspirin_physics_optuna",
  "results_root": "results/optuna",
  "mode": "physics",
  "n_trials": 1,
  "timeout": null,
  "resume": true,
  "seed": 42,
  "objective": {
    "metric": "val_total_mse_loss",
    "direction": "minimize",
    "penalties": []
  },
  "trainer": {
    "max_epochs": 10,
    "num_workers": 0,
    "enable_progress_bar": false,
    "deterministic": false,
    "val_check_interval": 0.5,
    "num_sanity_val_steps": 0
  },
  "sampler": {
    "name": "TPESampler",
    "kwargs": {
      "seed": 42
    }
  },
  "pruner": {
    "name": "SuccessiveHalvingPruner",
    "kwargs": {
      "min_resource": 1,
      "reduction_factor": 3,
      "min_early_stopping_rate": 0
    }
  },
  "fixed_params": {
    "dataset": "MD17",
    "molecule": "aspirin",
    "model_type": "tensornet",
    "delta_learning": true,
    "baseline_epsilon_eV": 0.01,
    "baseline_sigma_A": 1.0,
    "baseline_cutoff_A": 5.0,
    "train_loss": "mse_loss",
    "train_loss_arg": null,
    "pbc_weight": 0.0
  },
  "search_space": {
    "common": {
      "batch_size": {
        "type": "categorical",
        "choices": [16, 32]
      },
      "lr": {
        "type": "float",
        "low": 1e-05,
        "high": 0.001,
        "log": true
      },
      "weight_decay": {
        "type": "float",
        "low": 1e-08,
        "high": 0.0001,
        "log": true
      },
      "embedding_dimension": {
        "type": "categorical",
        "choices": [64, 128, 256]
      },
      "num_layers": {
        "type": "categorical",
        "choices": [2, 4, 6]
      },
      "num_rbf": {
        "type": "categorical",
        "choices": [32, 64]
      },
      "energy_weight": {
        "type": "float",
        "low": 0.01,
        "high": 0.25
      },
      "force_weight": {
        "type": "float",
        "low": 0.75,
        "high": 0.99
      }
    },
    "physics": {
      "momentum_weight": {
        "type": "float",
        "low": 0.0,
        "high": 0.05
      },
      "nve_weight": {
        "type": "float",
        "low": 0.0,
        "high": 0.05
      }
    },
    "delta": {
      "baseline_epsilon_eV": {
        "type": "float",
        "low": 0.001,
        "high": 0.05,
        "log": true
      },
      "baseline_sigma_A": {
        "type": "float",
        "low": 0.5,
        "high": 2.0
      },
      "baseline_cutoff_A": {
        "type": "float",
        "low": 3.0,
        "high": 8.0
      }
    },
    "nve": {
      "traj_length": {
        "type": "categorical",
        "choices": [20, 30, 40]
      },
      "nve_freq": {
        "type": "categorical",
        "choices": [10, 25, 50]
      },
      "nve_warmup_epochs": {
        "type": "categorical",
        "choices": [0, 1, 2]
      },
      "nve_ramp_epochs": {
        "type": "categorical",
        "choices": [1, 3, 5]
      },
      "nve_relative": {
        "type": "bool"
      },
      "nve_relative_eps": {
        "type": "float",
        "low": 1e-08,
        "high": 0.0001,
        "log": true
      },
      "nve_loss_mode": {
        "type": "categorical",
        "choices": ["total_energy", "potential_only"]
      },
      "nve_dt_fs": {
        "type": "categorical",
        "choices": [0.1, 0.5]
      }
    }
  }
}
